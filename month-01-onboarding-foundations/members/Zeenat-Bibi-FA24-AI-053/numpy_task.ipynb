Task 2:
arr = np.random.randint(1, 21, size=(3, 3))

masked_arr = np.ma.array(arr)

np.fill_diagonal(masked_arr.mask, True)

print("Original Array:")
print(arr)

print("\nMasked Array:")
print(masked_arr)

mean_value = masked_arr.mean()

masked_arr = masked_arr.filled(mean_value)

print("\nAfter replacing diagonal with mean:")
print(masked_arr)
