Task 1:
arr = np.array([
    [1, 2, 3],
    [0, 1, 4],
    [5, 6, 0]
])

print("Matrix:")
print(arr)

det = np.linalg.det(arr)

print("\nDeterminant:")
print(det)

inverse = np.linalg.inv(arr)

print("\nInverse:")
print(inverse)

eigenvalues = np.linalg.eigvals(arr)

print("\nEigenvalues:")
print(eigenvalues)
