Task 2:
arr = np.arange(1, 10).reshape(3, 3)

print("Original Array:")
print(arr)

mean = np.mean(arr)
std = np.std(arr)

normalized = (arr - mean) / std

print("\nNormalized Array:")
print(normalized)

print("\nMean:", np.mean(normalized))
print("Standard Deviation:", np.std(normalized))
